{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://southworks.com/schemas/ux-assessment-report.schema.json",
  "title": "UX Assessment Report",
  "description": "Structured output schema for automated UX assessments combining Nielsen heuristics, Impeccable anti-pattern detection, axe-core accessibility, Lighthouse performance, and cognitive load analysis.",
  "type": "object",
  "required": ["metadata", "summary", "heuristics", "antiPatterns", "accessibility", "cognitiveLoad"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["timestamp", "target", "tools"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when the assessment was run"
        },
        "target": {
          "type": "object",
          "required": ["type", "identifier"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["component", "route", "url", "library"],
              "description": "What kind of target was assessed"
            },
            "identifier": {
              "type": "string",
              "description": "Path, URL, or component selector identifying the target"
            },
            "project": {
              "type": "string",
              "description": "Library/project name within the monorepo"
            }
          }
        },
        "tools": {
          "type": "object",
          "description": "Versions of tools used in this assessment",
          "properties": {
            "impeccable": { "type": "string" },
            "axeCore": { "type": "string" },
            "lighthouse": { "type": "string" },
            "backstopjs": { "type": "string" }
          }
        },
        "duration": {
          "type": "number",
          "description": "Total assessment duration in milliseconds"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["overallScore", "rating", "topIssues"],
      "properties": {
        "overallScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Weighted composite score (0-100). Weights: heuristics 35%, accessibility 30%, anti-patterns 20%, cognitive load 15%"
        },
        "rating": {
          "type": "string",
          "enum": ["excellent", "good", "acceptable", "poor", "critical"],
          "description": "Human-readable rating derived from overallScore"
        },
        "topIssues": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/issue"
          },
          "description": "Top 5 highest-priority issues across all categories"
        },
        "strengths": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string" },
          "description": "Top strengths identified in the assessment"
        }
      }
    },
    "heuristics": {
      "type": "object",
      "description": "Nielsen's 10 Usability Heuristics scored 0-4 each (max 40 total)",
      "required": ["scores", "totalScore"],
      "properties": {
        "totalScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 40,
          "description": "Sum of all 10 heuristic scores"
        },
        "scores": {
          "type": "object",
          "required": [
            "visibilityOfSystemStatus",
            "matchBetweenSystemAndRealWorld",
            "userControlAndFreedom",
            "consistencyAndStandards",
            "errorPrevention",
            "recognitionRatherThanRecall",
            "flexibilityAndEfficiency",
            "aestheticAndMinimalistDesign",
            "helpUsersWithErrors",
            "helpAndDocumentation"
          ],
          "properties": {
            "visibilityOfSystemStatus": { "$ref": "#/$defs/heuristicScore" },
            "matchBetweenSystemAndRealWorld": { "$ref": "#/$defs/heuristicScore" },
            "userControlAndFreedom": { "$ref": "#/$defs/heuristicScore" },
            "consistencyAndStandards": { "$ref": "#/$defs/heuristicScore" },
            "errorPrevention": { "$ref": "#/$defs/heuristicScore" },
            "recognitionRatherThanRecall": { "$ref": "#/$defs/heuristicScore" },
            "flexibilityAndEfficiency": { "$ref": "#/$defs/heuristicScore" },
            "aestheticAndMinimalistDesign": { "$ref": "#/$defs/heuristicScore" },
            "helpUsersWithErrors": { "$ref": "#/$defs/heuristicScore" },
            "helpAndDocumentation": { "$ref": "#/$defs/heuristicScore" }
          }
        }
      }
    },
    "antiPatterns": {
      "type": "object",
      "description": "Impeccable CLI anti-pattern detection results",
      "required": ["findings", "score"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Anti-pattern score 0-4 (4 = no AI tells, distinctive design)"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["antipattern", "name", "severity", "file", "snippet"],
            "properties": {
              "antipattern": {
                "type": "string",
                "enum": [
                  "ai-color-palette", "all-caps-body", "body-text-viewport-edge",
                  "border-accent-on-rounded", "bounce-easing", "cramped-padding",
                  "dark-glow", "everything-centered", "flat-type-hierarchy",
                  "gradient-text", "gray-on-color", "hero-eyebrow-chip",
                  "icon-tile-stack", "italic-serif-display", "justified-text",
                  "layout-transition", "line-length", "low-contrast",
                  "monotonous-spacing", "nested-cards", "overused-font",
                  "pure-black-white", "repeated-section-kickers", "side-tab",
                  "single-font", "skipped-heading", "tight-leading",
                  "tiny-text", "wide-tracking"
                ]
              },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["error", "warning", "info"]
              },
              "file": { "type": "string" },
              "line": { "type": "number" },
              "snippet": { "type": "string" }
            }
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "description": "axe-core accessibility audit results mapped to WCAG criteria",
      "required": ["score", "violations", "passes"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Accessibility score 0-4 based on WCAG conformance level"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "impact", "description", "nodes"],
            "properties": {
              "id": {
                "type": "string",
                "description": "axe-core rule ID (e.g. 'color-contrast', 'button-name')"
              },
              "impact": {
                "type": "string",
                "enum": ["critical", "serious", "moderate", "minor"]
              },
              "description": { "type": "string" },
              "helpUrl": {
                "type": "string",
                "format": "uri"
              },
              "wcagCriteria": {
                "type": "array",
                "items": { "type": "string" },
                "description": "WCAG success criteria IDs (e.g. ['1.4.3', '1.4.6'])"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "selector": { "type": "string" },
                    "html": { "type": "string" },
                    "failureSummary": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "passes": {
          "type": "number",
          "description": "Number of axe-core rules that passed"
        },
        "incomplete": {
          "type": "number",
          "description": "Number of rules that could not be automatically determined"
        }
      }
    },
    "cognitiveLoad": {
      "type": "object",
      "description": "Cognitive load assessment based on Impeccable's cognitive-load reference",
      "required": ["rating", "checklist"],
      "properties": {
        "rating": {
          "type": "string",
          "enum": ["low", "moderate", "high"],
          "description": "Overall cognitive load: low (0-1 failures), moderate (2-3), high (4+)"
        },
        "checklist": {
          "type": "object",
          "description": "8-item cognitive load checklist (true = passes, false = fails)",
          "properties": {
            "singleFocus": { "type": "boolean" },
            "chunking": { "type": "boolean" },
            "grouping": { "type": "boolean" },
            "visualHierarchy": { "type": "boolean" },
            "oneThingAtATime": { "type": "boolean" },
            "minimalChoices": { "type": "boolean" },
            "workingMemory": { "type": "boolean" },
            "progressiveDisclosure": { "type": "boolean" }
          }
        },
        "maxDecisionPoints": {
          "type": "number",
          "description": "Maximum number of simultaneous visible options at any decision point (>4 = overload)"
        }
      }
    },
    "performance": {
      "type": "object",
      "description": "Lighthouse CI performance metrics (optional, populated when Lighthouse runs)",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Lighthouse performance score 0-100"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "firstContentfulPaint": { "type": "number", "description": "FCP in ms" },
            "largestContentfulPaint": { "type": "number", "description": "LCP in ms" },
            "totalBlockingTime": { "type": "number", "description": "TBT in ms" },
            "cumulativeLayoutShift": { "type": "number", "description": "CLS score" },
            "speedIndex": { "type": "number", "description": "SI in ms" }
          }
        },
        "budgets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "metric": { "type": "string" },
              "budget": { "type": "number" },
              "actual": { "type": "number" },
              "passed": { "type": "boolean" }
            }
          }
        }
      }
    },
    "visualRegression": {
      "type": "object",
      "description": "BackstopJS visual regression results (optional)",
      "properties": {
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "viewport": { "type": "string" },
              "passed": { "type": "boolean" },
              "misMatchPercentage": { "type": "number" },
              "diffImage": { "type": "string", "description": "Relative path to diff image" }
            }
          }
        },
        "totalPassed": { "type": "number" },
        "totalFailed": { "type": "number" }
      }
    },
    "issues": {
      "type": "array",
      "description": "All individual issues found, with priority and category",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "heuristicScore": {
      "type": "object",
      "required": ["score"],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "rationale": {
          "type": "string",
          "description": "Brief justification for the score"
        },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["priority", "category", "description"],
      "properties": {
        "priority": {
          "type": "string",
          "enum": ["P0", "P1", "P2", "P3"],
          "description": "P0=blocking, P1=major, P2=minor, P3=polish"
        },
        "category": {
          "type": "string",
          "enum": [
            "accessibility",
            "anti-pattern",
            "cognitive-load",
            "performance",
            "heuristic-violation",
            "visual-regression"
          ]
        },
        "heuristic": {
          "type": "string",
          "description": "Which Nielsen heuristic this relates to (if applicable)"
        },
        "description": {
          "type": "string",
          "description": "Concise description of the issue"
        },
        "location": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "line": { "type": "number" },
            "selector": { "type": "string" }
          }
        },
        "suggestion": {
          "type": "string",
          "description": "Actionable fix suggestion"
        },
        "impact": {
          "type": "string",
          "enum": ["critical", "serious", "moderate", "minor"]
        }
      }
    }
  }
}
