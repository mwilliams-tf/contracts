{
  "id": "clm-chat-mvp",
  "viewports": [
    {
      "label": "desktop",
      "width": 1280,
      "height": 800
    },
    {
      "label": "tablet",
      "width": 768,
      "height": 1024
    },
    {
      "label": "mobile",
      "width": 375,
      "height": 812
    }
  ],
  "scenarios": [
    {
      "label": "Tablero",
      "url": "http://127.0.0.1:5173/",
      "delay": 1000,
      "misMatchThreshold": 0.1,
      "requireSameDimensions": true
    },
    {
      "label": "Chat IA",
      "url": "http://127.0.0.1:5173/chat",
      "delay": 1000,
      "misMatchThreshold": 0.1,
      "requireSameDimensions": true
    },
    {
      "label": "Solicitud",
      "url": "http://127.0.0.1:5173/solicitud",
      "delay": 1000,
      "misMatchThreshold": 0.1,
      "requireSameDimensions": true
    }
  ],
  "paths": {
    "bitmaps_reference": "backstop_data/bitmaps_reference",
    "bitmaps_test": "backstop_data/bitmaps_test",
    "html_report": "backstop_data/html_report",
    "ci_report": "backstop_data/ci_report"
  },
  "engine": "puppeteer",
  "engineOptions": {
    "args": ["--no-sandbox"]
  },
  "report": ["browser", "CI"],
  "asyncCaptureLimit": 5,
  "asyncCompareLimit": 50,
  "debug": false,
  "debugWindow": false
}
